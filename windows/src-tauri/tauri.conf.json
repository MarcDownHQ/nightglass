{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Nightglass",
  "version": "0.1.0",
  "identifier": "com.marcdownhq.nightglass",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nightglass",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxMTFCQjc3REQ0NEQwQkYKUldTLzBFVGRkN3NSd1FDMDRMMUp1Vzl5MUs5R0VteC9XQnNhdVM1dUF0QlFRaVdJYTJiVjdLL00K",
      "endpoints": ["https://github.com/MarcDownHQ/nightglass/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "lib/libmpv-2.dll": "libmpv-2.dll",
      "lib/libmpv-version.txt": "licenses/libmpv-version.txt",
      "../licenses/": "licenses/",
      "../../LICENSE": "licenses/Nightglass-LICENSE.txt"
    },
    "publisher": "MarcDownHQ",
    "copyright": "Copyright (c) 2026 MarcDownHQ",
    "category": "Video",
    "shortDescription": "Neon IPTV player",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
