<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Nightglass - Rust crate licences</title>
<style>
  body { font-family: 'Segoe UI', sans-serif; max-width: 960px; margin: 2em auto; padding: 0 16px; color: #222; }
  pre { white-space: pre-wrap; background: #f6f6f6; padding: 12px; font-size: 12px; }
  li { margin: 2px 0; }
</style>
</head>
<body>
<h1>Rust crates in Nightglass</h1>
<p>The licences of the crates compiled into nightglass.exe, generated by cargo-about.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>Licences</h2>
{{#each licenses}}
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
